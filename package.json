{
	"name": "portfoliopress",
	"version": "1.0.0",
	"description": "My personal portfolio project.",
	"main": "index.js",
	"scripts": {
		"sass": "sass wordpress/wp-content/themes/fictional-theme/css/style.scss:wordpress/wp-content/themes/fictional-theme/build/index.css --watch --no-source-map",
		"browsersync": "browser-sync start --proxy localhost:8080 --files \"wordpress/**/*.php\" \"wordpress/**/*.css\" \"wordpress/**/*.js\"",
		"watch": "npm-run-all --parallel sass browsersync",
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "docker-compose up -d && npm run watch",
		"stop": "docker-compose down"
	},
	"author": "mpk.coding@gmail.com",
	"license": "ISC",
	"devDependencies": {
		"@glidejs/glide": "^3.7.1",
		"browsersync": "^0.0.1-security",
		"npm-run-all": "^4.1.5",
		"sass": "^1.93.2"
	}
}
